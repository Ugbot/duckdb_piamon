# name: test/sql/local/paimon_write.test
# group: [local]
#
# Write path: CREATE TABLE + INSERT through the Paimon catalog, then read back. The written tables
# are also verified to be readable by pypaimon (the reference implementation) in the cross-engine
# checks under scripts/ — here we assert the in-engine round trip.

require parquet

statement ok
LOAD '__WORKING_DIRECTORY__/build/release/extension/iceberg/paimon.duckdb_extension';

statement ok
ATTACH '__TEST_DIR__' AS pm (TYPE paimon);

statement ok
CREATE TABLE pm.paimon_write_t (id BIGINT, name VARCHAR, score DOUBLE);

statement ok
INSERT INTO pm.paimon_write_t SELECT i, 'name_' || i, i * 1.5 FROM range(10) t(i);

# Read back the first commit.
query III
SELECT count(*), sum(id), round(sum(score), 1) FROM pm.paimon_write_t;
----
10	45	67.5

query T
SELECT name FROM pm.paimon_write_t ORDER BY id LIMIT 3;
----
name_0
name_1
name_2

# A second INSERT must append (carry prior manifests forward), not replace.
statement ok
INSERT INTO pm.paimon_write_t SELECT i, 'name_' || i, i * 1.5 FROM range(10, 15) t(i);

query II
SELECT count(*), sum(id) FROM pm.paimon_write_t;
----
15	105

# Two APPEND snapshots exist after two commits.
query IT
SELECT snapshot_id, commit_kind FROM paimon_snapshots('__TEST_DIR__/paimon_write_t') ORDER BY snapshot_id;
----
1	APPEND
2	APPEND

# --- Primary-key write: INSERT writes system columns; a later INSERT of an existing key upserts. ---
statement ok
CREATE TABLE pm.pk_w (id BIGINT PRIMARY KEY, v VARCHAR);

statement ok
INSERT INTO pm.pk_w SELECT i, 'a' || i FROM range(5) t(i);

statement ok
INSERT INTO pm.pk_w VALUES (2, 'updated'), (5, 'new');

# Merge-on-read: id 2 upserted to 'updated', id 5 appended; 6 distinct keys.
query IT
SELECT id, v FROM pm.pk_w ORDER BY id;
----
0	a0
1	a1
2	updated
3	a3
4	a4
5	new

# DELETE writes delete tombstones; merge-on-read then drops those keys.
statement ok
DELETE FROM pm.pk_w WHERE id IN (0, 5);

query IT
SELECT id, v FROM pm.pk_w ORDER BY id;
----
1	a1
2	updated
3	a3
4	a4

# A re-INSERT of a previously deleted key brings it back (higher sequence wins).
statement ok
INSERT INTO pm.pk_w VALUES (0, 'reborn');

query IT
SELECT id, v FROM pm.pk_w WHERE id = 0;
----
0	reborn

# UPDATE rewrites matched rows (upsert with the new value); unchanged columns are preserved.
statement ok
UPDATE pm.pk_w SET v = 'patched' WHERE id IN (2, 4);

query IT
SELECT id, v FROM pm.pk_w ORDER BY id;
----
0	reborn
1	a1
2	patched
3	a3
4	patched

# --- Compaction: rewrite the active files into one; logical content is preserved. ---
# pk_w currently has 5 keys spread across several data files (inserts/upsert/delete/update).
query I
SELECT files_compacted >= 2 FROM paimon_compact('__TEST_DIR__/pk_w');
----
true

query IT
SELECT id, v FROM pm.pk_w ORDER BY id;
----
0	reborn
1	a1
2	patched
3	a3
4	patched

# After compaction the latest snapshot references a single data file.
query I
SELECT files_compacted FROM paimon_compact('__TEST_DIR__/pk_w');
----
0

# --- Composite primary key: INSERT/upsert, DELETE, UPDATE identify rows by the full key. ---
statement ok
CREATE TABLE pm.ck (k1 BIGINT, k2 BIGINT, v VARCHAR, PRIMARY KEY (k1, k2));

statement ok
INSERT INTO pm.ck VALUES (1,1,'a'),(1,2,'b'),(2,1,'c'),(2,2,'d');

statement ok
DELETE FROM pm.ck WHERE k1 = 1 AND k2 = 2;

statement ok
UPDATE pm.ck SET v = 'C2' WHERE k1 = 2 AND k2 = 1;

query III
SELECT k1, k2, v FROM pm.ck ORDER BY k1, k2;
----
1	1	a
2	1	C2
2	2	d

# --- CREATE TABLE AS: create + populate from a query in one statement. ---
statement ok
CREATE TABLE pm.ctas_t AS SELECT i AS id, 'v' || i AS v FROM range(5) t(i);

query II
SELECT count(*), sum(id) FROM pm.ctas_t;
----
5	10

query IT
SELECT id, v FROM pm.ctas_t ORDER BY id LIMIT 2;
----
0	v0
1	v1

# DROP removes the table from the catalog and deletes its directory.
statement ok
DROP TABLE pm.paimon_write_t;

statement error
SELECT count(*) FROM pm.paimon_write_t;
----

statement ok
DETACH pm;

# --- Tag & branch management commands ---------------------------------------------------------
# Build a dedicated table with two snapshots (commit 1: ids 0-2; commit 2: id 3).
statement ok
ATTACH '__TEST_DIR__' AS rf (TYPE paimon);

statement ok
CREATE TABLE rf.t (id BIGINT, v BIGINT);

statement ok
INSERT INTO rf.t VALUES (0, 100), (1, 101), (2, 102);

statement ok
INSERT INTO rf.t VALUES (3, 103);

# Create a tag at snapshot 1 (3 rows) and a tag at the latest snapshot (4 rows).
query TI
SELECT name, snapshot_id FROM paimon_create_tag('__TEST_DIR__/t', 'v1', 1);
----
v1	1

query TI
SELECT name, snapshot_id FROM paimon_create_tag('__TEST_DIR__/t', 'cur');
----
cur	2

# List tags.
query TI
SELECT tag_name, snapshot_id FROM paimon_tags('__TEST_DIR__/t') ORDER BY tag_name;
----
cur	2
v1	1

# Time-travel read at the tag: v1 sees only the first commit.
query I
SELECT count(*) FROM paimon_scan('__TEST_DIR__/t', version => 'v1');
----
3

query II
SELECT id, v FROM paimon_scan('__TEST_DIR__/t', version => 'v1') ORDER BY id;
----
0	100
1	101
2	102

# Creating a duplicate tag fails.
statement error
SELECT * FROM paimon_create_tag('__TEST_DIR__/t', 'v1');
----
already exists

# Create a branch from tag v1; it shares the main table's data files and reads identically to v1.
query TI
SELECT name, snapshot_id FROM paimon_create_branch('__TEST_DIR__/t', 'b1', 'v1');
----
b1	1

query II
SELECT id, v FROM paimon_scan('__TEST_DIR__/t', version => 'b1') ORDER BY id;
----
0	100
1	101
2	102

# The branch equals the table as of tag v1, row for row.
query I
SELECT count(*) FROM (
  SELECT * FROM paimon_scan('__TEST_DIR__/t', version => 'b1')
  EXCEPT
  SELECT * FROM paimon_scan('__TEST_DIR__/t', version => 'v1')
);
----
0

# Delete the tag and branch.
query TI
SELECT name, snapshot_id FROM paimon_delete_tag('__TEST_DIR__/t', 'cur');
----
cur	2

query I
SELECT count(*) FROM paimon_tags('__TEST_DIR__/t');
----
1

statement ok
SELECT * FROM paimon_delete_branch('__TEST_DIR__/t', 'b1');

# Deleting a missing branch fails.
statement error
SELECT * FROM paimon_delete_branch('__TEST_DIR__/t', 'b1');
----
does not exist

statement ok
DETACH rf;

# --- Snapshot expiration -----------------------------------------------------------------------
statement ok
ATTACH '__TEST_DIR__' AS ex (TYPE paimon);

statement ok
CREATE TABLE ex.exp (id BIGINT, v BIGINT);

statement ok
INSERT INTO ex.exp VALUES (1, 10), (2, 20);

statement ok
INSERT INTO ex.exp VALUES (3, 30);

statement ok
INSERT INTO ex.exp VALUES (4, 40);

# Three snapshots so far.
query I
SELECT count(*) FROM paimon_snapshots('__TEST_DIR__/exp');
----
3

# Tag the first snapshot, then expire down to the newest 1 snapshot.
statement ok
SELECT * FROM paimon_create_tag('__TEST_DIR__/exp', 'first', 1);

query I
SELECT expired_snapshots FROM paimon_expire_snapshots('__TEST_DIR__/exp', 1);
----
2

# Only one snapshot remains.
query I
SELECT count(*) FROM paimon_snapshots('__TEST_DIR__/exp');
----
1

# Live data is intact after expiration.
query II
SELECT count(*), sum(v) FROM paimon_scan('__TEST_DIR__/exp');
----
4	100

# The tagged (now-expired) snapshot is still readable — its data files were pinned by the tag.
query II
SELECT id, v FROM paimon_scan('__TEST_DIR__/exp', version => 'first') ORDER BY id;
----
1	10
2	20

statement ok
DETACH ex;
