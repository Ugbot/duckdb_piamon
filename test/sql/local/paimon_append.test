# name: test/sql/local/paimon_append.test
# group: [local]
#
# Reads native Apache Paimon 1.4.x tables produced by pypaimon
# (scripts/data_generators/generate_paimon_fixtures.py, seed=42).
# Generate with: .paimon-fixtures-venv/bin/python scripts/data_generators/generate_paimon_fixtures.py

require parquet

# Avro is needed only by the data-file-format test below (Avro-format data files); loading it into the
# database makes read_avro available to the scan's internal connection.
require avro

require-env DUCKDB_PAIMON_HAVE_GENERATED_DATA

# paimon is built as a separate loadable extension (not linked into the test binary), so load it
# explicitly from the in-tree build rather than via `require paimon`.
statement ok
LOAD '__WORKING_DIRECTORY__/build/release/extension/iceberg/paimon.duckdb_extension';

# --- Append-only, unaware bucket: exact row count + values via manifest-driven discovery ---
query I
SELECT count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/append_simple');
----
20

query III
SELECT id, name, round(score, 3) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/append_simple') ORDER BY id LIMIT 3;
----
0	udaxihhe	59.641
1	xdvxrcsn	38.477
2	bacghqta	59.589

# --- Partitioned append: total + per-partition counts ---
query I
SELECT count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/append_partitioned');
----
50

query TI
SELECT dt, count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/append_partitioned') GROUP BY dt ORDER BY dt;
----
2024-01-01	17
2024-01-02	17
2024-01-03	16

# --- Metadata introspection ---
query I
SELECT primary_keys FROM paimon_metadata('__WORKING_DIRECTORY__/data/generated/paimon/default.db/pk_dedup');
----
id

# --- Schema evolution: a column added between commits surfaces as NULL for older data files ---
query III
SELECT id, a, b FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/evolve') ORDER BY id;
----
0	10	NULL
1	11	NULL
2	12	NULL
3	13	x
4	14	y

# --- Schema evolution: a RENAMED column keeps its old data under the new name (field-id mapping,
# matching Spark/Flink). a was renamed to b after the first commit. ---
query II
SELECT id, b FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/renamed') ORDER BY id;
----
1	10
2	20
3	30

# --- Filter pushdown: predicates are translated into the inner parquet scan to prune row groups,
# while the full filter is still re-applied above the scan (results must be exact). ---
query I
SELECT count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/append_partitioned') WHERE dt = '2024-01-01';
----
17

query I
SELECT count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/append_partitioned') WHERE dt IN ('2024-01-01', '2024-01-02');
----
34

# OR across a value and a partition column (an OR must be applied whole or not at all in the prune).
query I
SELECT count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/append_partitioned') WHERE val < 100 OR dt = '2024-01-03';
----
21

# Range + AND on value columns.
query I
SELECT count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/append_partitioned') WHERE val >= 0 AND val < 100;
----
6

# A pushed predicate that matches nothing still returns the correct (empty) result.
query I
SELECT count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/append_partitioned') WHERE dt = '1999-01-01';
----
0

# --- Data file format dispatch: Avro-format data files are read via read_avro (not parquet). ---
query I
SELECT count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/fmt_avro');
----
10

query II
SELECT count(*) FILTER (WHERE v IS NOT NULL), count(DISTINCT id) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/fmt_avro');
----
10	10

# --- ORC-format data files cannot be read (no ORC reader); the scan must raise a clear error. ---
statement error
SELECT count(*) FROM paimon_scan('__WORKING_DIRECTORY__/data/generated/paimon/default.db/fmt_orc');
----
ORC data files

# --- Catalog ATTACH + catalog-integrated scan ---
statement ok
ATTACH '__WORKING_DIRECTORY__/data/generated/paimon/default.db' AS pm (TYPE paimon);

query I
SELECT count(*) FROM pm.append_simple;
----
20

query TI
SELECT dt, count(*) FROM pm.append_partitioned GROUP BY dt ORDER BY dt;
----
2024-01-01	17
2024-01-02	17
2024-01-03	16

statement ok
DETACH pm;
